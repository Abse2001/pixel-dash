From 2a7f5271ecca991c77832d4152f17bc9b1afa92e Mon Sep 17 00:00:00 2001
From: Ahmed Shebani <ashebani2003@gmail.com>
Date: Sun, 22 Nov 2026 13:33:18 +0100
Subject: [PATCH 7/9] Honor hard crossing constraints during greedy routing and
 goal acceptance

---
 lib/core.ts                                   | 12 ++-
 lib/prepared/DenseRoutingWorkspace.ts         |  1 +
 .../preloaded-goal-crossing-repro.snap.svg    | 12 +--
 ...oaded-single-layer-crossing-repro.snap.svg | 95 +++++--------------
 .../preloaded-goal-crossing-repro.test.ts     |  4 +-
 ...loaded-single-layer-crossing-repro.test.ts |  2 +-
 6 files changed, 41 insertions(+), 85 deletions(-)

diff --git a/lib/core.ts b/lib/core.ts
index e41e411..bbb4ba1 100644
--- a/lib/core.ts
+++ b/lib/core.ts
@@ -920,6 +920,9 @@ export class TinyHyperGraphSolver extends BaseSolver {
         if (assignedNetId !== -1 && assignedNetId !== state.currentRouteNetId) {
           continue
         }
+        if (!Number.isFinite(this.computeG(currentCandidate, neighborPortId))) {
+          continue
+        }
         this.onPathFound(currentCandidate)
         return
       }
@@ -1073,6 +1076,9 @@ export class TinyHyperGraphSolver extends BaseSolver {
         if (assignedNetId !== -1 && assignedNetId !== state.currentRouteNetId) {
           continue
         }
+        if (!Number.isFinite(this.computeG(currentCandidate, neighborPortId))) {
+          continue
+        }
         this.onPathFound(currentCandidate)
         return
       }
@@ -2266,8 +2272,10 @@ export class TinyHyperGraphSolver extends BaseSolver {
 class GreedyFinalRouteSolver extends TinyHyperGraphSolver {
   override computeG(
     currentCandidate: Candidate,
-    _neighborPortId: PortId,
+    neighborPortId: PortId,
   ): number {
-    return currentCandidate.g
+    return Number.isFinite(super.computeG(currentCandidate, neighborPortId))
+      ? currentCandidate.g
+      : Number.POSITIVE_INFINITY
   }
 }
diff --git a/lib/prepared/DenseRoutingWorkspace.ts b/lib/prepared/DenseRoutingWorkspace.ts
index a935f8c..81b980d 100644
--- a/lib/prepared/DenseRoutingWorkspace.ts
+++ b/lib/prepared/DenseRoutingWorkspace.ts
@@ -183,6 +183,7 @@ export class DenseRoutingWorkspace {
       previous = at
       const port = neighbors[at]!
       if (port === state.goalPortId) {
+        if (!Number.isFinite(solver.computeG(c, port))) continue
         solver.onPathFound(c)
         return
       }
