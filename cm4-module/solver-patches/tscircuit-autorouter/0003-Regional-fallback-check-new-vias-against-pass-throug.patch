+++ b/lib/autorouter-pipelines/AutoroutingPipeline9_PreloadedTraceGraph/Pipeline9RegionalFallbackSolver.ts
@@ -106,27 +106,32 @@ export const isPipeline9ObstacleConnectedToRoute = ({
