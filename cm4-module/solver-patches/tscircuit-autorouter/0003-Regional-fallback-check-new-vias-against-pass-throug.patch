-      movablePreloadedConnectionNames,
-      viaToPadClearance,
-    } = this.params
-    if (
-      !boardObstacles ||
-      !movablePreloadedConnectionNames ||
-      viaToPadClearance === undefined
-    ) {
-      return true
-    }
-    const hasViaConflict = hasPreloadedViaToBoardObstacleConflict({
-      routes,
-      movablePreloadedConnectionNames,
-      boardObstacles,
-      connMap: this.params.connMap,
-      layerCount: this.params.layerCount,
-      allowBlindAndBuriedVias: this.params.allowBlindAndBuriedVias,
-      viaToPadClearance,
-    })
-    if (hasViaConflict) {
+    const { movablePreloadedConnectionNames } = this.params
+    const viaToPadClearance = this.viaToObstacleClearance
+    const boardObstacles = this.regionalBoardObstacles
+    if (!boardObstacles) return true
+    const checkVias = (
+      candidateRoutes: HighDensityRoute[],
+      passThroughLayersOnly: boolean,
+    ) =>
+      hasViaToBoardObstacleConflict({
+        routes: candidateRoutes,
+        boardObstacles,
+        passThroughLayersOnly,
+        connMap: this.params.connMap,
+        layerCount: this.params.layerCount,
+        allowBlindAndBuriedVias: this.params.allowBlindAndBuriedVias,
+        viaToPadClearance,
+      })
+    const isPreloaded = (route: HighDensityRoute) =>
+      movablePreloadedConnectionNames?.has(route.connectionName) ?? false
+    if (checkVias(routes.filter(isPreloaded), false)) {
       this.stats.preloadedViaCandidateRejectionCount =
         Number(this.stats.preloadedViaCandidateRejectionCount ?? 0) + 1
+      return false
+    }
+    if (checkVias(routes.filter((route) => !isPreloaded(route)), true)) {
+      this.stats.viaCandidateRejectionCount =
+        Number(this.stats.viaCandidateRejectionCount ?? 0) + 1
+      return false
     }
-    return !hasViaConflict
+    return true
   }
 
