-const hasPreloadedViaToBoardObstacleConflict = ({
+// The regional fallback opens its node to every layer and relies on board
+// obstacles to limit where layer transitions go. A via also occupies every
+// layer it passes through; the intra-node solvers only see obstacles on the
+// layers they route on, so obstacles on pass-through layers (such as an inner
+// keep-out) were never checked for new routes. `passThroughLayersOnly` limits
+// the test to obstacles that lie only on such layers; anything that also lies
+// on the via's end layers is already seen by the solvers (and the later DRC
+// repair), as before.
+const hasViaToBoardObstacleConflict = ({
   routes,
-  movablePreloadedConnectionNames,
   boardObstacles,
+  passThroughLayersOnly = false,
   connMap,
   layerCount,
   viaToPadClearance,
   allowBlindAndBuriedVias,
 }: {
   routes: HighDensityRoute[]
-  movablePreloadedConnectionNames: ReadonlySet<string>
   boardObstacles: Obstacle[]
+  passThroughLayersOnly?: boolean
   connMap: ConnectivityMap
   layerCount: number
   viaToPadClearance: number
   allowBlindAndBuriedVias?: boolean
 }): boolean =>
   routes.some((route) => {
-    if (!movablePreloadedConnectionNames.has(route.connectionName)) {
-      return false
-    }
     const viaSpans = getPipeline9RouteCopperGeometry(route, {
       layerCount,
       allowBlindAndBuriedVias,
@@ -136,7 +141,16 @@ const hasPreloadedViaToBoardObstacleConflict = ({
         if (isPipeline9ObstacleConnectedToRoute({ obstacle, route, connMap }))
           return false
         const obstacleZLayers = getObstacleZLayers(obstacle, layerCount)
-        if (!obstacleZLayers.some((z) => z >= via.minZ && z <= via.maxZ)) {
+        const spanned = obstacleZLayers.filter(
+          (z) => z >= via.minZ && z <= via.maxZ,
+        )
+        if (spanned.length === 0) return false
+        // An obstacle that also lies on one of the via's end layers is visible
+        // to the intra-node solvers; only pass-through-only obstacles are not.
+        if (
+          passThroughLayersOnly &&
+          spanned.some((z) => z === via.minZ || z === via.maxZ)
+        ) {
           return false
         }
         return (
@@ -154,12 +168,41 @@ export class Pipeline9RegionalFallbackSolver extends BaseSolver {
   forceImproveSolver?: RegionalForceImproveSolver
   repairSolver?: Pipeline4HighDensityRepairSolver
   private validatedRoutes?: HighDensityRoute[]
+  /** Board obstacles near the fallback node: the only ones a candidate via can reach. */
+  private readonly regionalBoardObstacles?: Obstacle[]
+  private readonly viaToObstacleClearance: number
 
   constructor(params: Pipeline9RegionalFallbackSolverParams) {
     super()
     this.params = params
+    // Without an explicit via-to-pad rule a via still needs the board's
+    // obstacle margin; skipping the check would let vias into keep-outs.
+    this.viaToObstacleClearance =
+      params.viaToPadClearance ?? params.obstacleMargin
+    if (params.boardObstacles) {
+      const node = params.nodeWithPortPoints
+      const reach =
+        params.viaDiameter / 2 +
+        this.viaToObstacleClearance +
+        Math.max(params.obstacleMargin, params.traceWidth) * 2
+      const minX = node.center.x - node.width / 2 - reach
+      const maxX = node.center.x + node.width / 2 + reach
+      const minY = node.center.y - node.height / 2 - reach
+      const maxY = node.center.y + node.height / 2 + reach
+      this.regionalBoardObstacles = params.boardObstacles.filter((obstacle) => {
+        const halfExtent =
+          Math.hypot(obstacle.width, obstacle.height) / 2
+        return (
+          obstacle.center.x + halfExtent >= minX &&
+          obstacle.center.x - halfExtent <= maxX &&
+          obstacle.center.y + halfExtent >= minY &&
+          obstacle.center.y - halfExtent <= maxY
+        )
+      })
+    }
     this.stats = {
       preloadedViaCandidateRejectionCount: 0,
+      viaCandidateRejectionCount: 0,
       forceImproveCandidateRejectionCount: 0,
       repairCandidateRejectionCount: 0,
     }
