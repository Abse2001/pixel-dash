From e41e24bcfec43ec8ee6ab054aa28315395796cf5 Mon Sep 17 00:00:00 2001
From: Ahmed Alshaybani <shibosoftwaredev@gmail.com>
Date: Sat, 21 Nov 2026 00:21:31 +0100
Subject: [PATCH 1/8] Keep protected escape vias fixed during bounds clamping

---
 lib/HighDensityForceImproveSolver.ts        |  1 +
 tests/protected-escape-via-clamping.test.ts | 28 +++++++++++++++++++++
 2 files changed, 29 insertions(+)
 create mode 100644 tests/protected-escape-via-clamping.test.ts

diff --git a/lib/HighDensityForceImproveSolver.ts b/lib/HighDensityForceImproveSolver.ts
index 71aa805..751ab22 100644
--- a/lib/HighDensityForceImproveSolver.ts
+++ b/lib/HighDensityForceImproveSolver.ts
@@ -403,6 +403,7 @@ const getClearanceForceMagnitude = (
 }
 
 const clampNodeToBounds = (node: MutableNode, bounds: Bounds) => {
+  if (node.fixed) return
   const inset = node.boundaryPadding > 0 ? BOUNDARY_INSET : 0
   const minX = bounds.minX + node.boundaryPadding + inset
   const maxX = bounds.maxX - node.boundaryPadding - inset
diff --git a/tests/protected-escape-via-clamping.test.ts b/tests/protected-escape-via-clamping.test.ts
new file mode 100644
index 0000000..1720eb7
--- /dev/null
+++ b/tests/protected-escape-via-clamping.test.ts
@@ -0,0 +1,28 @@
+import { expect, test } from "bun:test"
+import { runForceDirectedImprovement } from "../lib/HighDensityForceImproveSolver"
+import type { HighDensityRoute } from "../lib/types/high-density-types"
+
+test("bounds clamping preserves a protected pad escape before force movement", (): void => {
+  const route: HighDensityRoute = {
+    connectionName: "signal",
+    traceThickness: 0.1,
+    viaDiameter: 0.3,
+    route: [
+      { x: -0.5, y: 0, z: 0 },
+      { x: -0.49, y: 0, z: 0 },
+      { x: -0.49, y: 0, z: 1 },
+      { x: 0.4, y: 0, z: 1 },
+    ],
+    vias: [{ x: -0.49, y: 0 }],
+  }
+  const original = structuredClone(route)
+  const result = runForceDirectedImprovement(
+    { minX: -0.5, maxX: 0.5, minY: -0.5, maxY: 0.5 },
+    [route],
+    0,
+  )
+
+  expect(result.routes[0]!.route).toEqual(original.route)
+  expect(result.routes[0]!.vias).toEqual(original.vias)
+  expect(route).toEqual(original)
+})
